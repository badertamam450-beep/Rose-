rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.email is string && data.email.size() <= 320
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation for StoryboardProject
    function isValidStoryboardProject(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'stylePreset', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && (!('logline' in data) || (data.logline is string && data.logline.size() <= 2000))
        && data.stylePreset is string && data.stylePreset.size() <= 100
        && (!('defaultImageSize' in data) || (data.defaultImageSize is string && data.defaultImageSize.size() <= 20))
        && (!('defaultAspectRatio' in data) || (data.defaultAspectRatio is string && data.defaultAspectRatio.size() <= 20))
        && (!('rawScript' in data) || (data.rawScript is string && data.rawScript.size() <= 100000))
        && (!('scenes' in data) || (data.scenes is list && data.scenes.size() <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User Profile match block
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    // Storyboard Projects match block
    match /projects/{projectId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId)
        && incoming().userId == request.auth.uid
        && incoming().id == projectId
        && isValidStoryboardProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId)
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && isValidStoryboardProject(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'logline', 'stylePreset', 'defaultImageSize', 'defaultAspectRatio', 'rawScript', 'scenes', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(projectId)
        && existing().userId == request.auth.uid;
    }
  }
}
